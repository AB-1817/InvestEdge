# InvestEdge Backend — Environment Variables Example
# Copy this file to .env and fill in your values on the server

# ── Primary LLM Keys (Groq Cloud) ─────────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_API_KEY_2=your_optional_second_groq_api_key_here

# ── Google Gemini / Vertex Key (for Embeddings & Google ADK Agents) ───────────
GOOGLE_API_KEY=your_google_api_key_here

# ── Multi-Agent System v2 Settings (Phase 3) ──────────────────────────────────
# Agent Model Provider: 'gemini', 'groq', 'litellm', or 'mock' (default: gemini if GOOGLE_API_KEY set, else groq)
AGENT_MODEL_PROVIDER=groq
# Default model names per provider
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
# Enable Critic & Reflection Engine to verify draft groundedness
AGENT_ENABLE_REFLECTION=true

# ── Vector RAG Settings (Phase 2) ─────────────────────────────────────────────
# Embedding Provider: 'gemini', 'sentence_transformers', or 'fake'
EMBEDDING_PROVIDER=gemini
# Enable real vector RAG over legacy headline-stuffing in orchestrator
USE_VECTOR_RAG=false
# Chroma Vector DB Storage Location
CHROMA_PERSIST_DIR=data/chroma_db
# Admin Token protecting POST /api/v2/rag/ingest
RAG_ADMIN_TOKEN=your_secure_admin_token_here

# ── Relational Database / Signal Ledger ───────────────────────────────────────
INVESTEDGE_DB_PATH=data/investedge.db

# ── Configurable trusted CORS origins (comma-separated list) ──────────────────
# Default includes https://invest-edge-eight.vercel.app, http://localhost:5173, etc.
CORS_ORIGINS=https://invest-edge-eight.vercel.app,http://localhost:5173,http://localhost:3000
